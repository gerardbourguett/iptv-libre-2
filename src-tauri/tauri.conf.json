{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "libre-iptv-2",
  "version": "0.1.0",
  "identifier": "com.gabc_.libre-iptv-2",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "libre-iptv-2",
        "width": 1100,
        "height": 700,
        "minWidth": 1000,
        "minHeight": 640,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["lib/**/*", "licenses/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
